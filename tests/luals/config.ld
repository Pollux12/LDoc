-- Configuration for LuaLS annotation testing
project = "LuaLS Test"
title = "LuaLS Annotation Test Documentation"
description = "Testing LuaLS annotation parsing and conversion"

-- Enable LuaLS annotation parsing
luals = true

-- Disable LDoc compatibility mode for pure LuaLS testing
ldoc_compat = false

-- File to process
file = "luals_test.lua"

-- Output settings
format = "markdown"
dir = "luals_docs"
